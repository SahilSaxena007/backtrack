# Gemini API Key (required for AI features)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Base Path for folder browsing (optional, defaults to user home directory)
# If set, the app will show folders under this path instead of home directory
# Example: BASE_PATH=C:\Users\backtrack-testing
BASE_PATH=

# MCP Allowed Paths (comma-separated list of folders the app can access)
MCP_ALLOWED_PATHS=/Users/you/Downloads,/Users/you/Documents
