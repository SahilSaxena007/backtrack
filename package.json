{
  "name": "backtrack",
  "version": "1.0.0",
  "description": "AI-Powered File Organization Desktop App",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:8000 && tsc -p tsconfig.main.json && electron .",
    "build": "tsc -p tsconfig.main.json && vite build && electron-builder",
    "build:main": "tsc -p tsconfig.main.json",
    "lint": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SahilSaxena007/backtrack.git"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "file-organization",
    "gemini"
  ],
  "author": "Sahil Saxena",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SahilSaxena007/backtrack/issues"
  },
  "homepage": "https://github.com/SahilSaxena007/backtrack#readme",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/fs-extra": "^11.0.4",
    "chokidar": "^3.5.0",
    "dotenv": "^17.2.4",
    "electron-store": "^8.2.0",
    "framer-motion": "^10.16.0",
    "fs-extra": "^11.3.3",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}
